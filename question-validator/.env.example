# Copy to .env (git-ignored). Values here are placeholders.

# Where the database, exports and caches live (default: ./data)
QV_DATA_DIR=./data
# Override the database URL (default: sqlite:///<QV_DATA_DIR>/validation.db)
# QV_DB_URL=sqlite:///./data/validation.db

# API keys — needed from phase 2 on. Never commit real keys; never paste them in chat.
# Free tiers only (decision 2026-11-15). Keep billing DISABLED on the Google AI Studio project,
# so the free tier can never turn into charges.
GEMINI_API_KEY=
TAVILY_API_KEY=
# Optional extra free search pools
EXA_API_KEY=
SERPER_API_KEY=
